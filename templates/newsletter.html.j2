<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ subject }}</title>
  </head>
  <body>
    <p><strong>{{ badge }}</strong></p>

    <h2>핵심 이슈</h2>
    <ol>
      {% for item in hot %}
      <li>
        <a href="{{ item.url }}">{{ item.title }}</a><br />
        <small>출처: {{ item.source_domain }}</small><br />
        {% set lines = item.lines or [] %}
        {% set summary = ((lines[0] if lines|length > 0 else '') ~ ' ' ~ (lines[1] if lines|length > 1 else '')).strip() %}
        {% if summary %}
        <p><strong>핵심 정리:</strong> {{ summary }}</p>
        {% endif %}
        {% if lines|length > 2 %}
        <p><strong>왜 중요한가:</strong> {{ lines[2] }}</p>
        {% endif %}
        {% if lines|length > 3 %}
        <p><strong>실무 적용:</strong> {{ lines[3] }}</p>
        {% endif %}
        {% if lines|length > 4 %}
        <p><strong>세부 포인트:</strong></p>
        <ul>
          {% for point in lines[4:] %}
          <li>{{ point }}</li>
          {% endfor %}
        </ul>
        {% endif %}
      </li>
      {% endfor %}
    </ol>

    <h2>추가 이슈</h2>
    <ol>
      {% for item in bottom %}
      <li>
        <a href="{{ item.url }}">{{ item.title }}</a><br />
        <small>출처: {{ item.source_domain }}</small><br />
        {% set lines = item.lines or [] %}
        {% set summary = ((lines[0] if lines|length > 0 else '') ~ ' ' ~ (lines[1] if lines|length > 1 else '')).strip() %}
        {% if summary %}
        <p><strong>핵심 정리:</strong> {{ summary }}</p>
        {% endif %}
        {% if lines|length > 2 %}
        <p><strong>왜 중요한가:</strong> {{ lines[2] }}</p>
        {% endif %}
        {% if lines|length > 3 %}
        <p><strong>실무 적용:</strong> {{ lines[3] }}</p>
        {% endif %}
      </li>
      {% endfor %}
    </ol>

    <p><a href="{{ satisfaction_url }}">오늘 뉴스레터 만족도</a></p>
    <p><a href="{{ unsubscribe_url }}">구독 해지</a></p>
  </body>
</html>
